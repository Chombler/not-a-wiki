---
import { getCollection } from 'astro:content';
import ResearchBranch from '../../components/ResearchBranch.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const branchDefinitions = [
  ['spellcraft', 'Spellcraft', 'Spellcraft.png'],
  ['craftsmanship', 'Craftsmanship', 'Craftsmanship.png'],
  ['divine', 'Divine', 'Divine.png'],
  ['economics', 'Economics', 'Economics.png'],
  ['alchemy', 'Alchemy', 'Alchemy.png'],
  ['warfare', 'Warfare', 'Warfare.png'],
  ['forbidden', 'Forbidden', 'Forbidden.png'],
] as const;
const research = await getCollection('research');
const numericCode = (code: string) => Number(code.slice(1));
const byBranch = Object.fromEntries(branchDefinitions.map(([key]) => [
  key,
  research.filter((entry) => entry.data.branch === key).sort((a, b) => numericCode(a.data.code) - numericCode(b.data.code)),
]));
const base = import.meta.env.BASE_URL;
---

<SiteLayout title="Research List" sourcePath="src/content/research/README.md">
  <h6><img src={`${base}Factions/picks/ResearchTopPage.png`} alt="Research" /></h6>
  <p>Information about how Research Slots and Budget work can be found at <b><a href={`${base}Research`}>Research</a></b>.</p>
  <p>All Researches can also be found in a graphical form at <b><a href={`${base}Researchtree`}>Research Tree</a></b>.</p>
  <p class="reference-source-note">Research facts are maintained once in <a href="https://github.com/chombler/not-a-wiki/tree/codex/modernization-first-pass/src/content/research">human-editable YAML records</a>.</p>
  <hr />
  <p><b>Research Facilities</b>:</p>
  <div class="shlisting">
    {branchDefinitions.map(([key, name, icon]) => <ResearchBranch name={name} icon={icon} entries={byBranch[key]} />)}
  </div>
</SiteLayout>
