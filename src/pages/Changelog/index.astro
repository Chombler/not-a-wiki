---
import SiteLayout from '../../layouts/SiteLayout.astro';
import changelog from '../../page-content/reference/Changelog.fragment?raw';
import { frameGameIcons } from '../../lib/gameIcons';

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const content = frameGameIcons(changelog
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`));
---

<SiteLayout title="Changelog" sourcePath="src/page-content/reference/Changelog.fragment">
  <Fragment set:html={content} />
</SiteLayout>
