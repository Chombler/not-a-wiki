---
import SiteLayout from '../../layouts/SiteLayout.astro';
import changelog from '../../page-content/reference/Changelog.fragment?raw';

const base = import.meta.env.BASE_URL;
const content = changelog
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`);
---

<SiteLayout title="Changelog" sourcePath="src/page-content/reference/Changelog.fragment">
  <Fragment set:html={content} />
</SiteLayout>
