---
import SiteLayout from '../layouts/SiteLayout.astro';
import homeContent from '../page-content/home.html?raw';
import { frameGameIcons } from '../lib/gameIcons';

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const renderedHome = frameGameIcons(homeContent
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`));
---

<SiteLayout home sourcePath="src/page-content/home.html">
  <Fragment set:html={renderedHome} />
</SiteLayout>
