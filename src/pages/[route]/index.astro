---
import SiteLayout from '../../layouts/SiteLayout.astro';
import GuidePage from '../../components/GuidePage.astro';
import { getPageTitle } from '../../data/pageTitles';
import { guideSequence } from '../../data/guides';
import { isTierTableKind, tierTableHtml } from '../../lib/tierTables';
import { primalBalanceTableHtml } from '../../lib/primalBalance';

const pageModules = import.meta.glob('../../page-content/reference/*.html', {
  eager: true,
  import: 'default',
  query: '?raw',
}) as Record<string, string>;

export function getStaticPaths() {
  const modules = import.meta.glob('../../page-content/reference/*.html', {
    eager: true,
    import: 'default',
    query: '?raw',
  });
  const referencePaths = Object.keys(modules).map((source) => {
    const route = source.split('/').pop()!.replace(/\.html$/, '');
    return { params: { route }, props: { source, kind: 'reference' } };
  });
  const guidePaths = Object.keys(guideSequence).map((route) => ({
    params: { route }, props: { source: '', kind: 'guide' },
  }));
  return [...referencePaths, ...guidePaths];
}

interface Props { source: string; kind: 'reference' | 'guide'; }
const { route } = Astro.params;
const { source, kind } = Astro.props;
if (!route) throw new Error('Static reference route is missing');
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const baseContent = kind === 'reference' ? pageModules[source]
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`) : '';
const content = baseContent.replaceAll(
  '<realm-primal-balance-table></realm-primal-balance-table>',
  primalBalanceTableHtml(),
).replace(
  /<realm-tier-table data-kind="([^"]+)" data-heading="([^"]*)"><\/realm-tier-table>/g,
  (_element, kind: string, heading: string) => {
    if (!isTierTableKind(kind)) throw new Error(`Unknown tier table ${kind} on ${route}`);
    return tierTableHtml(kind, heading);
  },
);
---

<SiteLayout title={getPageTitle(route)} sourcePath={kind === 'guide' ? `src/data/guides/${route.slice(0, 2)}.json` : `src/page-content/reference/${route}.html`}>
  {kind === 'guide' ? <GuidePage route={route} /> : <Fragment set:html={content} />}
</SiteLayout>
