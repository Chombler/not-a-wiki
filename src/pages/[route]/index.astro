---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPageTitle } from '../../data/pageTitles';
import siteScope from '../../data/site-scope.json';
import { isTierTableKind, tierTableHtml } from '../../lib/tierTables';
import { primalBalanceTableHtml } from '../../lib/primalBalance';
import { frameGameIcons } from '../../lib/gameIcons';
import { getCollection } from 'astro:content';
import { trophyDrawerHtml, trophyListHtml, validateTrophyCategories, type TrophyCategory } from '../../lib/trophies';
import { spellMenuHtml, validateSpellMenu, type SpellMenu } from '../../lib/spells';

const pageModules = import.meta.glob('../../page-content/reference/*.html', {
  eager: true,
  import: 'default',
  query: '?raw',
}) as Record<string, string>;

export function getStaticPaths() {
  const modules = import.meta.glob('../../page-content/reference/*.html', {
    eager: true,
    import: 'default',
    query: '?raw',
  });
  const withheld = new Set(siteScope.withheldGuidanceRoutes);
  const referencePaths = Object.keys(modules).flatMap((source) => {
    const route = source.split('/').pop()!.replace(/\.html$/, '');
    return withheld.has(route) ? [] : [{ params: { route }, props: { source } }];
  });
  return referencePaths;
}

const { route } = Astro.params;
const { source } = Astro.props;
if (!route) throw new Error('Static reference route is missing');
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const trophyCategories = (await getCollection('trophies'))
  .map((entry) => entry.data as TrophyCategory)
  .sort((left, right) => left.order - right.order);
validateTrophyCategories(trophyCategories);
const spellMenuEntries = await getCollection('spellMenu');
if (spellMenuEntries.length !== 1) throw new Error(`Expected one spell menu file; found ${spellMenuEntries.length}`);
const spellMenu = spellMenuEntries[0].data as SpellMenu;
validateSpellMenu(spellMenu);
const baseContent = pageModules[source]
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`);
const content = frameGameIcons(baseContent
  .replace('<realm-trophy-drawer></realm-trophy-drawer>', trophyDrawerHtml(trophyCategories, base))
  .replace('<realm-trophy-list></realm-trophy-list>', trophyListHtml(trophyCategories, base))
  .replace('<realm-spell-menu></realm-spell-menu>', spellMenuHtml(spellMenu, base))
  .replaceAll(
  '<realm-primal-balance-table></realm-primal-balance-table>',
  primalBalanceTableHtml(),
).replace(
  /<realm-tier-table data-kind="([^"]+)" data-heading="([^"]*)"><\/realm-tier-table>/g,
  (_element, kind: string, heading: string) => {
    if (!isTierTableKind(kind)) throw new Error(`Unknown tier table ${kind} on ${route}`);
    return tierTableHtml(kind, heading);
  },
));
const ascensionOrder = ['Ascension', 'Ascension1', 'Ascension2', 'Ascension3', 'Ascension4'];
const ascensionIndex = ascensionOrder.indexOf(route);
const ascensionLabels: Record<string, string> = {
  Ascension: 'Overview', Ascension1: 'Ascension 1', Ascension2: 'Ascension 2', Ascension3: 'Ascension 3', Ascension4: 'Ascension 4',
};
const previousAscension = ascensionIndex > 0 ? ascensionOrder[ascensionIndex - 1] : undefined;
const nextAscension = ascensionIndex >= 0 && ascensionIndex < ascensionOrder.length - 1 ? ascensionOrder[ascensionIndex + 1] : undefined;
---

<SiteLayout title={getPageTitle(route)} sourcePath={['TrophyPage', 'AllTrophies'].includes(route) ? 'src/content/trophies/README.md' : `src/page-content/reference/${route}.html`}>
  {ascensionIndex >= 0 && <nav class="reference-sibling-nav" aria-label="Ascension pages">
    {previousAscension ? <a href={`${base}${previousAscension}`}>&larr; {ascensionLabels[previousAscension]}</a> : <span></span>}
    <a href={`${base}Ascension`}>Ascensions overview</a>
    {nextAscension ? <a href={`${base}${nextAscension}`}>{ascensionLabels[nextAscension]} &rarr;</a> : <span></span>}
  </nav>}
  <Fragment set:html={content} />
  {ascensionIndex >= 0 && <nav class="reference-sibling-nav reference-sibling-nav-bottom" aria-label="Ascension pages">
    {previousAscension ? <a href={`${base}${previousAscension}`}>&larr; {ascensionLabels[previousAscension]}</a> : <span></span>}
    <a href={`${base}Ascension`}>Ascensions overview</a>
    {nextAscension ? <a href={`${base}${nextAscension}`}>{ascensionLabels[nextAscension]} &rarr;</a> : <span></span>}
  </nav>}
</SiteLayout>
