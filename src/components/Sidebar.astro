---
import { navigation } from '../data/navigation';

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const url = (path: string) => `${base}${path}`;
const currentRoute = Astro.url.pathname.replace(base, '').replace(/^\/+|\/+$/g, '');
const containsCurrent = (item: { href: string; pages: { href: string }[] }) =>
  item.href === currentRoute || item.pages.some((page) => page.href === currentRoute);
---

<aside class="site-sidebar" id="site-sidebar">
  <label class="page-filter-label" for="page-filter">Find a reference page</label>
  <input id="page-filter" class="page-filter" type="search" placeholder="Filter pages…" autocomplete="off" />
  <nav class="progression-nav" aria-label="Realm Grinder progression">
    {navigation.map((group, groupIndex) => (
      <section class:list={['progression-group', group.className]}>
        <h2>{group.label}</h2>
        <ul>
          {group.items.map((item, itemIndex) => (
            <li class:list={{
              'guide-nav-era': true,
              'is-current-branch': containsCurrent(item),
            }}>
              <div class="sidebar-category-row">
                <a class="sidebar-category-link" href={url(item.href)} aria-current={item.href === currentRoute ? 'page' : undefined}>{item.label}</a>
                <button class="sidebar-category" type="button" aria-label={`Toggle ${item.label} pages`} aria-expanded={containsCurrent(item) ? 'true' : 'false'} aria-controls={`sidebar-pages-${groupIndex}-${itemIndex}`}>
                  <span class="sidebar-category-icon" aria-hidden="true">›</span>
                </button>
              </div>
              <ul class="guide-range-nav" id={`sidebar-pages-${groupIndex}-${itemIndex}`} hidden={!containsCurrent(item)}>
                {item.pages.map((page) => <li><a href={url(page.href)} aria-current={page.href === currentRoute ? 'page' : undefined}>{page.label}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
