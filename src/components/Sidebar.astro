---
import { navigation } from '../data/navigation';

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const url = (path: string) => `${base}${path}`;
const currentRoute = Astro.url.pathname.replace(base, '').replace(/^\/+|\/+$/g, '');
const containsCurrent = (item: { href: string; children?: { href: string }[] }) =>
  item.href === currentRoute || Boolean(item.children?.some((child) => child.href === currentRoute));
---

<aside class="site-sidebar" id="site-sidebar">
  <label class="page-filter-label" for="page-filter">Find a reference page</label>
  <input id="page-filter" class="page-filter" type="search" placeholder="Filter pages…" autocomplete="off" />
  <nav class="progression-nav" aria-label="Realm Grinder progression">
    {navigation.map((group) => (
      <section class:list={['progression-group', group.className]}>
        <h2>{group.label}</h2>
        <ul>
          {group.items.map((item) => (
            <li class:list={{
              'guide-nav-era': Boolean(item.children),
              'is-current-branch': containsCurrent(item),
              'is-current-root': item.href === currentRoute,
              'child-mode-current': item.childDisplay === 'current',
            }}>
              <a href={url(item.href)} aria-current={item.href === currentRoute ? 'page' : undefined}>{item.label}</a>
              {item.children && (
                <ul class="guide-range-nav">
                  {item.children.map((child) => <li class:list={{ 'is-current-item': child.href === currentRoute }}><a href={url(child.href)} aria-current={child.href === currentRoute ? 'page' : undefined}>{child.label}</a></li>)}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </nav>
</aside>
