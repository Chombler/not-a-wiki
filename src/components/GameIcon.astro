---
import { alignmentColors, iconPresentationForAffiliation, type IconAffiliation } from '../lib/referenceIcons';

interface Props {
  icon: string;
  label?: string;
  affiliation?: IconAffiliation;
}

const { icon, label = '', affiliation } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const presentation = iconPresentationForAffiliation(affiliation);
const styles = [
  presentation.trim && `--reference-icon-frame:url("${base}assets/game/sprites/${presentation.trim}-trim.png")`,
  presentation.primary && `--reference-icon-primary:${alignmentColors[presentation.primary]}`,
  presentation.secondary && `--reference-icon-secondary:${alignmentColors[presentation.secondary]}`,
].filter(Boolean).join(';');
const split = Boolean(presentation.primary && presentation.secondary);
---

<span class:list={['game-icon-frame', { 'game-icon-frame--split': split }]} style={styles || undefined}>
  <img src={`${base}assets/game/sprites/${icon}`} alt={label} />
</span>
