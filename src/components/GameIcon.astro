---
import { iconTrimForAffiliation, type IconAffiliation } from '../lib/referenceIcons';

interface Props {
  icon: string;
  label?: string;
  affiliation?: IconAffiliation;
}

const { icon, label = '', affiliation } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const trim = iconTrimForAffiliation(affiliation);
const frameStyle = trim
  ? `--reference-icon-frame: url("${base}assets/game/sprites/${trim}-trim.png")`
  : undefined;
---

<span class="game-icon-frame" style={frameStyle}>
  <img src={`${base}assets/game/sprites/${icon}`} alt={label} />
</span>
