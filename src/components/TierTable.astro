---
import { tierRows, type TierTableKind } from '../lib/tierTables';

interface Props {
  kind: TierTableKind;
  heading: string;
}

const { kind, heading } = Astro.props;
const rows = tierRows(kind);
---

<table class="numtable tier-table">
  <caption><b>{heading}</b></caption>
  <thead><tr><th>Tier</th><th>Building</th><th>Bonus / formula</th></tr></thead>
  <tbody>
    {rows.map((row) => <tr><td>{row.tier}</td><td>{row.building}</td><td>{row.value}</td></tr>)}
  </tbody>
</table>
