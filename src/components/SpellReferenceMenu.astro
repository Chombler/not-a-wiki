---
import type { SpellMenu, SpellMenuEntry } from '../lib/spells';
import type { ReferenceIconItem } from '../lib/referenceIcons';
import ReferenceIconGrid from './ReferenceIconGrid.astro';

interface Props {
  menu: SpellMenu;
}

const { menu } = Astro.props;
const referenceItems = (entries: SpellMenuEntry[]): ReferenceIconItem[] => entries.map((entry) => ({
  label: entry.name,
  icon: entry.icon,
  href: `#${entry.target}`,
  tooltipHtml: entry.tooltip,
}));
---

<div class="spell-reference-grids">
  <ReferenceIconGrid title="Spells" items={referenceItems(menu.spells)} variant="spell" />

  <details class="spell-related-grids">
    <summary>Spell Trophies and Challenge Rewards</summary>
    <div class="spell-related-grid-panels">
      <ReferenceIconGrid title="Spell Trophies" items={referenceItems(menu.upgrades)} variant="upgrade" />
      <ReferenceIconGrid title="Challenge Rewards" items={referenceItems(menu.challenges)} variant="challenge" />
    </div>
  </details>
</div>
