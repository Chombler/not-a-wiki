---
import GameIcon from './GameIcon.astro';
import { alignmentColors, iconPresentationForAffiliation, type ReferenceIconItem } from '../lib/referenceIcons';

interface Props {
  item: ReferenceIconItem;
  variant?: string;
}

const { item, variant } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const escapeHtml = (value: string) => value
  .replaceAll('&', '&amp;')
  .replaceAll('"', '&quot;')
  .replaceAll('<', '&lt;')
  .replaceAll('>', '&gt;');
const bodyForBase = (body: string) => body
  .replaceAll('/realm/', base)
  .replaceAll('/realm"', `${base}"`);
const frameTooltipIcons = (body: string) => body.replace(
  /<img\b[^>]*\/assets\/game\/sprites\/[^>]*>/gi,
  (image) => `<span class="game-icon-frame">${image}</span>`,
);
const label = escapeHtml(item.label);
const tooltipPresentation = iconPresentationForAffiliation(item.affiliation);
const tooltipStyles = [
  tooltipPresentation.trim && `--reference-icon-frame:url(${base}assets/game/sprites/${tooltipPresentation.trim}-trim.png)`,
  tooltipPresentation.primary && `--reference-icon-primary:${alignmentColors[tooltipPresentation.primary]}`,
  tooltipPresentation.secondary && `--reference-icon-secondary:${alignmentColors[tooltipPresentation.secondary]}`,
].filter(Boolean).join(';');
const tooltipSplit = tooltipPresentation.primary && tooltipPresentation.secondary ? ' game-icon-frame--split' : '';
const tooltipFrameStyle = tooltipStyles ? ` style="${tooltipStyles}"` : '';
const tooltipHeading = `<p><span class="game-icon-frame${tooltipSplit}"${tooltipFrameStyle}><img src="${base}assets/game/sprites/${item.icon}" alt="${label}"></span><b> ${label}</b></p>`;
const tooltip = `${tooltipHeading}${frameTooltipIcons(bodyForBase(item.tooltipHtml))}`;
const tooltipAttribute = { research: tooltip };
const className = ['reference-icon-button', variant && `reference-icon-button--${variant}`].filter(Boolean).join(' ');
---

{item.href ? (
  <a class={className} {...tooltipAttribute} href={item.href} aria-label={item.label}>
    <GameIcon icon={item.icon} label={item.label} affiliation={item.affiliation} />
  </a>
) : (
  <button type="button" class={className} {...tooltipAttribute} aria-label={item.label}>
    <GameIcon icon={item.icon} label={item.label} affiliation={item.affiliation} />
  </button>
)}
